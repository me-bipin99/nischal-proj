NODE_ENV=development
PORT=4000

MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/shopsense

JWT_SECRET=your-secret-key-here
JWT_EXPIRES_IN=7d

CORS_ORIGIN=http://localhost:5500

# API base URL (used to build reorder confirmation links in emails)
SERVER_URL=http://localhost:4000

# Frontend base URL (used to redirect supplier back to the alerts page after confirming)
FRONTEND_URL=http://localhost:5500

# SMTP settings — use Ethereal (https://ethereal.email) for local/demo, or a real provider for production
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=your-ethereal-user@ethereal.email
SMTP_PASS=your-ethereal-password
SMTP_FROM="ShopSense Inventory <noreply@shopsense.dev>"
