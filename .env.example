# Environment variables for the ShopSense API (server/).
# Copy this file to server/.env and fill in real values.
# See server/.env.example for the authoritative copy.

NODE_ENV=development
PORT=4000

MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/shopsense

JWT_SECRET=your-secret-key-here
JWT_EXPIRES_IN=7d

CORS_ORIGIN=http://localhost:5500
